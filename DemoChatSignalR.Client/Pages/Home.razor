@page "/"
@inject HttpService<IHome> iHomeService
<PageTitle>Home</PageTitle>
<div class="chat-home">

    <div class="intro">
        <h1>Web Chat Box</h1>
        <p class="subtitle">
            Nền tảng trò chuyện thời gian thực – nhanh, gọn;
        </p>
        <p class="description">
            Web Chat Box giúp bạn kết nối và trao đổi thông tin tức thì.
        </p>

        <div class="actions">
            <TextBoxWithEnter Label="Nhập tên phòng" @bind-Value="roomName" eventEnter="OnEnter" />
        </div>
    </div>

    <div class="features">
        <div class="feature">
            <h3>⚡ Thời gian thực</h3>
            <p>Tin nhắn được gửi và nhận ngay lập tức.</p>
        </div>
    </div>

</div>
@code {
    public string roomName { get; set; } = "";
    private async Task OnEnter(string RoomName)
    {
        var rlt = await iHomeService.Excute(x =>
            x.CreateRoom(new()
            {
                NameRoom = roomName
            }));
        if (rlt.Success)
            Console.WriteLine($@"{rlt.Item.Guid},
{rlt.Item.Name},
{rlt.Item.TotalCount}");
        else Console.WriteLine(rlt.Message);
    }
}
}