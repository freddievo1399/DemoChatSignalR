<button type="@(Submit ? "submit" : "button")"
        class="@($"{ClassCss} btn-custome")"
        @onclick="HandleClick">

    @if (!string.IsNullOrEmpty(Icon))
    {
        <i class="@($"{Icon} {IconCss}")"></i>
    }

    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="@LabelCss">@Label</span>
    }
</button>
@code {
    [Parameter]
    public string ClassCss { get; set; }

    [Parameter] public string Icon { get; set; }
    [Parameter] public string IconCss { get; set; }

    [Parameter] public string Label { get; set; }
    [Parameter] public string LabelCss { get; set; }


    [Parameter] public bool Submit { get; set; }

    // Chuẩn Blazor
    [Parameter] public EventCallback OnClick { get; set; }

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate && !Submit)
            await OnClick.InvokeAsync();
    }
}
