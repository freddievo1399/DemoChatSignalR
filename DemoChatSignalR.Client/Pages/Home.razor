@page "/"
@using System.Threading.Tasks
@using MudBlazor
@inject HttpService<IHome> iHomeService
@inject NavigationManager Nav
@inject SwalAlertService Swal
<PageTitle>Home</PageTitle>
<div class="chat-home">

    <div class="intro">
        <h1>Web Chat Box</h1>
        <p class="subtitle">
            Nền tảng trò chuyện thời gian thực – nhanh, gọn;
        </p>
        <p class="description">
            Web Chat Box giúp bạn kết nối và trao đổi thông tin tức thì.
        </p>

        <EditForm Model="reqCreateRoom" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <div class="actions row">
                <div class="row">
                    <MudTextField @bind-Value="reqCreateRoom.NameRoom" Label="Nhập tên phòng" Variant="Variant.Outlined" />
                    <ValidationMessage For="() => reqCreateRoom.NameRoom"></ValidationMessage>
                </div>
                <div class="row">
                    <MudButton Variant="Variant.Filled" EndIcon="@Icons.Material.Rounded.SubdirectoryArrowLeft" ButtonType="ButtonType.Submit" Color="Color.Primary">Vào phòng</MudButton>
                </div>
            </div>
        </EditForm>
    </div>

    <div class="features">
        <div class="feature">
            <h3>⚡ Thời gian thực</h3>
            <p>Tin nhắn được gửi và nhận ngay lập tức.</p>
        </div>
    </div>

</div>
@code {
    public ReqCreateRoom reqCreateRoom { get; set; } = new();

    async Task OnValidSubmit(EditContext editContext)
    {
        await Swal.Loading("Đang tạo phòng...");
        var rlt = await iHomeService.Excute(x =>
            x.CreateRoom(reqCreateRoom));

        if (rlt.Success)
        {
            await Swal.Loading("Đang chuyển");
            Nav.NavigateTo($@"/room/{rlt.Item.Guid}");
            await Swal.Close();
        }
        else
        {
            await Swal.Error($"Lỗi{rlt.Message}");
        }
    }
}