@page "/"
@using System.Threading.Tasks
@inject HttpService<IHome> iHomeService
@inject NavigationManager Nav
<PageTitle>Home</PageTitle>
<div class="chat-home">

    <div class="intro">
        <h1>Web Chat Box</h1>
        <p class="subtitle">
            Nền tảng trò chuyện thời gian thực – nhanh, gọn;
        </p>
        <p class="description">
            Web Chat Box giúp bạn kết nối và trao đổi thông tin tức thì.
        </p>

        <EditForm Model="reqCreateRoom" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <div class="actions row">
                <div class="row">
                    <TextBoxWithEnter Label="Nhập tên phòng" @bind-Value="reqCreateRoom.NameRoom" />
                    <ValidationMessage For="() => reqCreateRoom.NameRoom"></ValidationMessage>
                </div>
                <div class="row">
                    <ButtonIconBootstrap Submit ClassCss="btn-submit mx-auto"
                                         Icon="bi bi-arrow-return-left" IconCss="IconCss"
                                         Label="Vào phòng" LabelCss="LabelCss" />
                </div>
            </div>
        </EditForm>
    </div>

    <div class="features">
        <div class="feature">
            <h3>⚡ Thời gian thực</h3>
            <p>Tin nhắn được gửi và nhận ngay lập tức.</p>
        </div>
    </div>

</div>
@code {
    public ReqCreateRoom reqCreateRoom { get; set; } = new();

    async Task OnValidSubmit(EditContext editContext)
    {
        var rlt = await iHomeService.Excute(x =>
            x.CreateRoom(reqCreateRoom));

        if (rlt.Success)
            Nav.NavigateTo($@"/room/{rlt.Item.Guid}");
        else Console.WriteLine(rlt.Message);
    }
}